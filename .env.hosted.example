# One private professional installation. Copy to .env.hosted, which is ignored.
ARCA_DOMAIN=facturas.example.com
ARCA_LOGIN=profesional
# Generate with: docker run --rm -it caddy:2 caddy hash-password
# Single quotes preserve literal dollar signs in the bcrypt hash.
ARCA_PASSWORD_HASH='REPLACE_WITH_GENERATED_BCRYPT_HASH'
